diff --git a/bookings/templates/bookings/mine.html b/bookings/templates/bookings/mine.html
index 3759275..417ec89 100644
--- a/bookings/templates/bookings/mine.html
+++ b/bookings/templates/bookings/mine.html
@@ -1 +1,42 @@
-{% extends "base.html" %}{% block content %}<section class="hero"><h1>我的预订</h1><p class="muted">成员三继续实现预订、取消、到期与双方确认。</p></section><div class="grid">{% for reservation in reservations %}<article class="item"><h2>{{ reservation.listing.title }}</h2><p>{{ reservation.get_status_display }}</p><p>到期：{{ reservation.expires_at|date:"Y-m-d H:i" }}</p></article>{% empty %}<p>暂无预订。可以先用演示买家 student2 查看预置记录。</p>{% endfor %}</div>{% endblock %}
+{% extends "base.html" %}
+{% block content %}
+<section class="hero">
+  <h1>我的预订</h1>
+  <form method="get" action="{% url 'bookings:mine' %}">
+    <label for="reservation-status">预订状态</label>
+    <select name="status" id="reservation-status">
+      <option value=""{% if not selected_status %} selected{% endif %}>全部状态</option>
+      {% for value, label in status_choices %}
+        <option value="{{ value }}"{% if value == selected_status %} selected{% endif %}>{{ label }}</option>
+      {% endfor %}
+    </select>
+    <button type="submit">筛选</button>
+  </form>
+</section>
+<div class="grid">
+  {% for reservation in page_obj %}
+    <article class="item">
+      <h2>{{ reservation.listing.title }}</h2>
+      <p>{{ reservation.get_status_display }}</p>
+      <p>到期：{{ reservation.expires_at|date:"Y-m-d H:i" }}</p>
+    </article>
+  {% empty %}
+    {% if selected_status %}
+      <p>没有符合当前状态的预订。</p>
+    {% else %}
+      <p>暂无预订。</p>
+    {% endif %}
+  {% endfor %}
+</div>
+{% if page_obj.has_other_pages %}
+  <nav class="pagination" aria-label="预订分页">
+    {% if page_obj.has_previous %}
+      <a href="?page={{ page_obj.previous_page_number }}{% if selected_status %}&amp;status={{ selected_status|urlencode }}{% endif %}">上一页</a>
+    {% endif %}
+    <span>第 {{ page_obj.number }} / {{ page_obj.paginator.num_pages }} 页</span>
+    {% if page_obj.has_next %}
+      <a href="?page={{ page_obj.next_page_number }}{% if selected_status %}&amp;status={{ selected_status|urlencode }}{% endif %}">下一页</a>
+    {% endif %}
+  </nav>
+{% endif %}
+{% endblock %}
