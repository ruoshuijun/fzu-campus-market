# 可选配置清单；Django 不会自动加载 .env。
# PowerShell 使用：$env:DB_ENGINE = "postgres"
# 或运行 .\scripts\use-postgres.ps1（注意前面点和空格）。
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=postgres
POSTGRES_DB=fzu_market
POSTGRES_USER=fzu
POSTGRES_PASSWORD=local-demo-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
RESERVATION_TTL_SECONDS=86400
